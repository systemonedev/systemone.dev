// Cloudflare Workers deploy of the static site: `npm run build`, then `npx wrangler deploy`
// serves dist/ as static assets (public/_headers is applied as-is). No Worker code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "systemone-dev",
  // Branch builds run `wrangler preview` instead of `deploy`, and that command refuses to start
  // without this block, so every pull request showed a failed Workers build while the site itself
  // had built cleanly. Empty is all it needs: assets and compatibility settings stay top-level.
  "previews": {},
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Astro writes /concepts/index.html: serve it at /concepts/ and redirect /concepts to it
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
